#!/bin/sh
# Copyright (C) 2026 Isak Lindgren
# SPDX-License-Identifier: GPL-2.0-or-later
# Control the input lock from a shell, including over SSH.
#
#   input-lock-x on       disable keyboard + touchpad
#   input-lock-x off      re-enable them
#   input-lock-x toggle   flip whichever way it currently is
#   input-lock-x status   report unit, daemon, state file and matched devices
#
# For the case where things are already wedged, use input-lock-x-emergency-unlock.

set -u

UNIT="input-lock-x.service"
STATE="/run/input-lock-x.state"
DAEMON_BIN="/usr/local/bin/input-lock-x-daemon"

# The help text is the comment block at the top of this file. Extracted by
# shape rather than by line number: adding the SPDX line above already forced
# this from '2,9p' to '3,10p' once, the copyright line would have forced it
# again, and neither `sh -n` nor `make check` can catch a window that has slid.
# install.sh carries the same awk verbatim.
usage() {
    awk 'NR == 1 { next }
         /^#/ {
             sub(/^# ?/, "")
             if ($0 !~ /^(SPDX-License-Identifier:|Copyright )/)
                 print
             next
         }
         { exit }' "$0"
    exit "${1:-2}"
}

is_locked() {
    [ -e "$STATE" ]
}

need_root() {
    [ "$(id -u)" -eq 0 ] && return 0

    # `ssh host input-lock-x off` has no TTY, so sudo cannot prompt. Prefer the
    # passwordless path, and fail with instructions rather than on an
    # unanswerable prompt. Probe this exact command, not an unrelated one --
    # the sudoers drop-in is scoped to these two scripts.
    if sudo -n -l -- "$0" >/dev/null 2>&1; then
        exec sudo -n -- "$0" "$@"
    fi
    if [ ! -t 0 ]; then
        echo "input-lock-x needs root, but sudo wants a password and this" >&2
        echo "session has no terminal. Retry with:" >&2
        echo "    ssh -t <host> sudo input-lock-x $*" >&2
        exit 1
    fi
    exec sudo -- "$0" "$@"
}

cmd_status() {
    printf 'lock:       %s\n' "$(is_locked && echo ENGAGED || echo released)"
    printf 'unit:       %s\n' "$(systemctl is-active "$UNIT" 2>/dev/null)"
    printf 'state file: %s\n' "$([ -e "$STATE" ] && echo "$STATE" || echo absent)"

    if [ -x "$DAEMON_BIN" ]; then
        echo
        if [ "$(id -u)" -eq 0 ]; then
            "$DAEMON_BIN" --list
        else
            echo "devices:    (run as root to list matched devices)"
        fi
    else
        echo "daemon:     NOT INSTALLED at $DAEMON_BIN"
    fi
}

case "${1:-}" in
    on)
        need_root "$@"
        # The unit is Type=notify, so this only returns once the devices are
        # really grabbed -- but confirm against the state file rather than
        # reporting a lock we have not actually observed.
        if ! systemctl start "$UNIT"; then
            echo "failed to engage the input lock; see: journalctl -u $UNIT" >&2
            exit 1
        fi
        if is_locked; then
            echo "input lock engaged (Ctrl+Esc on the laptop releases it)"
        else
            echo "unit started but $STATE is missing; lock is NOT engaged" >&2
            exit 1
        fi
        ;;
    off)
        need_root "$@"
        systemctl stop "$UNIT" || exit 1
        if is_locked; then
            echo "unit stopped but $STATE remains; try input-lock-x-emergency-unlock" >&2
            exit 1
        fi
        echo "input lock released"
        ;;
    toggle)
        need_root "$@"
        if is_locked; then
            exec "$0" off
        else
            exec "$0" on
        fi
        ;;
    status)
        cmd_status
        ;;
    -h|--help|help)
        usage 0
        ;;
    *)
        usage 2
        ;;
esac
