// Let an active local session in the wheel group start and stop the HID lock
// unit without a password prompt -- a password prompt is useless when the
// keyboard is the thing being disabled.
//
// Scoped to this single unit: it grants no other systemd control. It also
// requires an active local seat, so it cannot be used over SSH (the
// hid-toggle / hid-emergency-unlock scripts use sudo for that).

polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "minibookx-hid-lock.service" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
