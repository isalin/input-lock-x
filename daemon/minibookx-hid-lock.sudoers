# Passwordless HID lock control for the wheel group.
#
# Installed to /etc/sudoers.d/minibookx-hid-lock (mode 0440), and validated
# with `visudo -c` before installation.
#
# Why this exists: `ssh laptop hid-emergency-unlock` allocates no TTY, so sudo
# cannot prompt for a password -- and that command is the documented way back
# in when the keyboard is disabled. Without this the emergency path fails at
# the moment it is needed.
#
# The scope is two root-owned scripts that only start/stop one systemd unit and
# clear input inhibit flags. It is the same privilege the polkit rule already
# grants an active local session; this extends it to SSH.
#
# To opt out: delete this file. The scripts still work as
#   ssh -t <host> sudo hid-emergency-unlock

%wheel ALL=(root) NOPASSWD: /usr/local/bin/hid-emergency-unlock, /usr/local/bin/hid-toggle
